generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(191)
  passwordHash String   @default("") @db.VarChar(191)
  role         String   @default("user") @db.VarChar(16)
  status       String   @default("ativo") @db.VarChar(16)
  createdAt    DateTime @default(now())
  checkins     Checkin[]
  measurements Measurement[]
  progress     Progress[]
}

model Setting {
  key       String   @id @db.VarChar(191)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Checkin {
  id        Int      @id @default(autoincrement())
  userId    Int
  moduleKey String   @db.VarChar(64)
  itemKey   String   @db.VarChar(64)
  date      String   @db.VarChar(10)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, moduleKey, itemKey, date])
}

model Measurement {
  id        Int      @id @default(autoincrement())
  userId    Int
  moduleKey String   @db.VarChar(64)
  value     Float
  date      String   @db.VarChar(10)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, moduleKey, date])
}

model Progress {
  id        Int      @id @default(autoincrement())
  userId    Int
  moduleKey String   @db.VarChar(64)
  stepKey   String   @db.VarChar(64)
  itemIndex Int      @default(-1)
  doneAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, moduleKey, stepKey, itemIndex])
}

model Profile {
  userId         Int      @id
  name           String?  @db.VarChar(191)
  goal           Float?
  startDate      String?  @db.VarChar(10)
  onboardingDone Boolean  @default(false)
  answers        String?  @db.Text
  updatedAt      DateTime @updatedAt
}

model Note {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String   @db.VarChar(10)
  text      String   @db.VarChar(280)
  createdAt DateTime @default(now())

  @@unique([userId, date])
}
